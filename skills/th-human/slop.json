  "structures": [
    {
      "id": "not-just",
      "regex": "(단순히|단순한) [^.!?\\n]{1,40}(가|이)? ?아니라",
      "name": "'단순히 X가 아니라 Y'",
      "fix": "Y만 말한다. 뒤집는 구조 자체가 AI 티다."
    },
    {
      "id": "not-only",
      "regex": "뿐만 아니라[^.!?\\n]{1,60}도",
      "name": "'X뿐만 아니라 Y도'",
      "fix": "두 문장으로 나누거나 약한 쪽을 지운다."
    },
    {
      "id": "isnt-about",
      "regex": "(이것은|이건|핵심은) [^.!?\\n]{1,40}(가|이) 아닙니다[.!] ?[^.!?\\n]{0,40}입니다",
      "name": "'X가 아닙니다. Y입니다'",
      "fix": "Y부터 말한다."
    },
    {
      "id": "rhetorical",
      "regex": "(?m)^\\s*(결과는|이유는|비결은|정답은|핵심은)\\s*(\\?|요\\?)\\s*$",
      "name": "한 줄짜리 수사 질문('결과는?')",
      "fix": "질문 없이 바로 답을 쓴다."
    },
    {
      "id": "ordinal",
      "regex": "첫째[^\\n]{0,80}\\n?[^\\n]{0,200}둘째[^\\n]{0,200}셋째",
      "name": "'첫째, 둘째, 셋째' 나열",
      "fix": "번호 목록이 필요하면 1. 2. 3.으로, 아니면 하나만 남긴다."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\u2600-\\u27BF\\U0001F300-\\U0001FAFF]\\s?[^\\n]+\\n\\s*[\\u2600-\\u27BF\\U0001F300-\\U0001FAFF]",
      "name": "이모지 글머리 목록(✅ 🔥 📌)",
      "fix": "이모지를 빼고 짧은 문장이나 숫자 목록으로."
    },
    {
      "id": "triple-exclaim",
      "regex": "!{2,}",
      "name": "느낌표 연타",
      "fix": "느낌표는 하나, 아니면 마침표."
    },
    {
      "id": "reflex-bait",
      "regex": "(팔로우 ?하고|저장해 ?두|저장 필수|공유 부탁|좋아요 ?부탁|끝까지 읽)",
      "name": "반사적인 부탁('저장 필수', '팔로우하고')",
      "fix": "정말 저장할 가치가 있으면 부탁 없이도 저장한다. 지운다."
    },
    {
      "id": "tag-wall",
      "regex": "(#[^\\s#]+\\s*){3,}",
      "name": "태그 벽",
      "fix": "쓰레드는 주제 태그 하나만 붙는다. 하나만 남긴다."
    },
    {
      "id": "uniform-formal",
      "regex": "((니다|습니다)\\.\\s*){4,}",
      "name": "'~니다.' 네 번 이상 연속",
      "fix": "끝맺음을 섞는다. 짧은 문장, 질문, 반말 한 줄."
    },
    {
      "id": "english-not-just",
      "regex": "(?i)\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b",
      "name": "\"It's not just X, it's Y\"",
      "fix": "Say the one thing you mean."
    }
  ]
}
